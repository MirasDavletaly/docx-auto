# Настройки DocFlow на Synology. Файл .env рядом готовит
# scripts/deploy/make-env.ps1 на компьютере разработчика – руками заполнять
# не нужно. Образец – чтобы было видно, что там лежит. В .env – пароли: в
# git и в пакет он не попадает; после загрузки на NAS копию на компьютере
# удалить.

# Имя проекта Docker: тома называются docflow_pgdata и т. д.
COMPOSE_PROJECT_NAME=docflow

# Имя сайта: на него Caddy получает сертификат Let's Encrypt.
DOCFLOW_SITE_NAME=docflow.synology.me

# Порт HTTPS на NAS. Роутер передаёт сюда внешний TCP 443.
DOCFLOW_HTTPS_PORT=8443

# Кто держит HTTPS: acme – Caddy с сертификатом Let's Encrypt (нужен проброс
# 443 на роутере); off – Tailscale Funnel на NAS, без проброса портов. Для off
# DOCFLOW_SITE_NAME – адрес Funnel (green-spark.tailXXXX.ts.net).
DOCFLOW_TLS=acme
# Порт сайта по http на 127.0.0.1 NAS – для Funnel (DOCFLOW_TLS=off).
DOCFLOW_LOCAL_PORT=8088

# Пароль на весь сайт (кроме /api), логин – docflow. Один на всех, его
# сообщают сотрудникам; хеш считает Caddy при запуске. Не короче 12 знаков,
# латиница, цифры и знаки, без пробелов и одинарной кавычки.
DOCFLOW_SITE_PASSWORD=replace-with-your-own-value
# Пароль на сайт: on – спрашивается (логин docflow); off – нет, остаётся
# только вход в DocFlow своим логином.
DOCFLOW_SITE_AUTH=on
# Пропуск после пароля на сайт (cookie на 30 дней), 64 знака hex. Смена –
# пароль на сайт спросят у всех заново.
DOCFLOW_GATE_TOKEN=

# Пароли базы: владелец (миграции, копии) и роль приложения docflow_app.
# Только шестнадцатеричные знаки – подставляются в адрес подключения как есть.
# Пароль владельца база запоминает при первом запуске: менять его в .env
# потом нельзя.
DOCFLOW_DB_OWNER_PASSWORD=
DOCFLOW_DB_APP_PASSWORD=

# Ключ подписи токенов входа. Смена – все входят заново.
DOCFLOW_JWT_SECRET=
