# Настройки публикации DocFlow. Скопируйте в deploy/.env и заполните.
# Файл .env в репозиторий не попадает (.gitignore).

# Домен сайта. У домена должна быть A-запись на IP сервера.
DOCFLOW_DOMAIN=docs.example.kz

# Почта для писем о сертификате HTTPS (Let's Encrypt).
DOCFLOW_ACME_EMAIL=admin@example.kz

# Пароль на весь сайт – до входа в само приложение.
# Хеш пароля получить так (на сервере, из папки deploy):
#   docker run --rm caddy:2.11-alpine caddy hash-password --plaintext 'ВашПароль'
# Хеш вставить В ОДИНАРНЫХ КАВЫЧКАХ: в нём есть знаки $.
DOCFLOW_AUTH_USER=docflow
DOCFLOW_AUTH_HASH='$2a$14$вставьте_сюда_хеш'
