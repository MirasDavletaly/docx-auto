# Образец окружения для разработки.
# Скопируйте в .env и при необходимости поправьте. Файл .env в репозиторий не попадает:
# секреты берутся только из окружения (CLAUDE.md, п. 3.10).

# ── Режим ────────────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=debug
LOG_JSON=true

# ── HTTP ─────────────────────────────────────────────────────────────────────
HTTP_ADDR=:8080
# Показатели и подробная проверка готовности. Наружу не публикуется.
METRICS_ADDR=:9090

# Таймауты HTTP-сервера (docs/architecture.md, п. 13).
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Предел обработки одного обращения; должен быть меньше HTTP_WRITE_TIMEOUT.
HTTP_REQUEST_TIMEOUT=20s
# Предел размера тела запроса: 1 МБ (CLAUDE.md, п. 3.11).
HTTP_MAX_BODY_BYTES=1048576
# Адрес клиента – из X-Forwarded-For. Только за своим прокси (Caddy).
HTTP_TRUST_PROXY=false
# Ограничения частоты, обращений в минуту: вход с адреса, API человека и компании.
RATE_LOGIN_PER_MINUTE=20
RATE_USER_PER_MINUTE=600
RATE_COMPANY_PER_MINUTE=3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Порт 6432 — это PgBouncer, а не сама база: приложение всегда ходит через него.
DATABASE_URL=postgres://docflow_app:docflow_app_password@localhost:6432/docflow
DATABASE_MAX_CONNS=10
DATABASE_STATEMENT_TIMEOUT=5s

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Объектное хранилище (MinIO) ──────────────────────────────────────────────
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=replace-with-your-own-value
STORAGE_SECRET_KEY=replace-with-your-own-value
STORAGE_BUCKET=docflow
STORAGE_USE_SSL=false

# ── Остановка ────────────────────────────────────────────────────────────────
# Сколько ждать завершения начатых обращений после сигнала.
SHUTDOWN_TIMEOUT=20s
